---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import { lien } from '../config';
import commun from '../i18n/commun';
import textes from '../i18n/merci';
import type { Langue } from '../i18n/routes';

interface Props { langue: Langue }
const { langue } = Astro.props;
const t = textes[langue];
const c = commun[langue];
---
<Base titre={t.meta.titre} description={t.meta.description} langue={langue} page="merci">
  <Bande hauteur="780px" biais="62%" reserve="0px">
    <div class="merci w">
      <div>
        <span class="etiq">{t.etiquette}</span>
        <h1>{t.titre.gras}<br /><span class="leger">{t.titre.leger}</span></h1>
        <p class="sous">{t.sous}</p>
        <div class="boutons">
          <a class="btn btn--plein" href={lien('realisations', langue)}>{c.voirRealisations}</a>
          <a class="btn btn--contour" href={lien('accueil', langue)}>{c.retourAccueil}</a>
        </div>
      </div>
      <div class="accuse">
        <span class="ok" aria-hidden="true">✓</span>
        <p class="accuse-titre">{t.accuse.titre}</p>
        <p class="accuse-sous">{t.accuse.sous}</p>
        <ol>{t.accuse.suite.map((s) => <li>{s}</li>)}</ol>
      </div>
    </div>
  </Bande>
</Base>

<style>
  .merci { display: grid; grid-template-columns: minmax(0, 600px) minmax(0, 1fr); gap: 80px; padding-top: 90px; min-height: 730px; align-items: start; }
  h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .accuse { margin-top: 30px; background: #fff; color: var(--encre); border-radius: 26px; padding: 26px 28px; max-width: 380px; box-shadow: 0 40px 80px -36px rgba(30,10,4,.55); font-family: var(--ui); }
  .ok { width: 46px; height: 46px; border-radius: 50%; background: #1F8A5B; color: #fff; display: grid; place-items: center; font-size: 20px; margin-bottom: 16px; }
  .accuse-titre { font: 800 20px var(--titre); letter-spacing: -.02em; margin-bottom: 6px; }
  .accuse-sous { font-size: 14.5px; color: var(--gris); }
  ol { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; counter-reset: etape; }
  li { display: flex; gap: 10px; counter-increment: etape; }
  li::before { content: counter(etape); color: var(--f2); font-weight: 700; }

  @media (max-width: 1100px) {
    .merci { grid-template-columns: 1fr; gap: 20px; min-height: 0; padding-bottom: 100px; }
  }
</style>
