---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import Iphone3D from '../components/Iphone3D.astro';
import CarteFlottante from '../components/CarteFlottante.astro';
import { lien } from '../config';
import { ecran } from '../lib/ecrans';
import commun from '../i18n/commun';
import textes from '../i18n/introuvable';
import type { Langue } from '../i18n/routes';

interface Props { langue: Langue }
const { langue } = Astro.props;
const t = textes[langue];
const c = commun[langue];
---
<Base titre={t.meta.titre} description={t.meta.description} langue={langue} indexer={false}>
  {langue === 'fr' && (
    <script is:inline slot="tete" define:vars={{ prefixe: lien('accueil', 'en'), cible: `${lien('accueil', 'en')}404/` }}>
      // GitHub Pages ne sert qu'un 404.html : une adresse anglaise inconnue est renvoyée vers la 404 anglaise.
      if (location.pathname.startsWith(prefixe) && location.pathname !== cible) location.replace(cible);
    </script>
  )}
  <Bande hauteur="820px" biais="64%" reserve="220px">
    <div class="perdu w">
      <div>
        <p class="code" aria-hidden="true">404</p>
        <h1>{t.titre}</h1>
        <p class="sous">{t.sous}</p>
        <div class="boutons">
          <a class="btn btn--plein" href={lien('accueil', langue)}>{c.retourAccueil}</a>
          <a class="btn btn--contour" href={lien('realisations', langue)}>{c.voirRealisations}</a>
        </div>
      </div>
      <div class="scene" aria-hidden="true">
        <Iphone3D ecran={ecran('pilpoil', 'Carte', langue)} largeur={250} haut="#F4F5F4" priorite style="left:120px;top:0;transform:rotateY(-20deg) rotateX(10deg) rotateZ(7deg)" />
        <CarteFlottante style="left:30px;top:300px">
          <span class="rond">?</span>
          <span><b>{t.carte.titre}</b><small>{t.carte.sous}</small></span>
        </CarteFlottante>
      </div>
    </div>
  </Bande>
</Base>

<style>
  .perdu { display: grid; grid-template-columns: minmax(0, 640px) minmax(0, 1fr); gap: 40px; padding-top: 70px; min-height: 780px; }
  .code { font-size: clamp(8rem, 18vw, 13.75rem); line-height: .8; letter-spacing: -.07em; font-weight: 800; color: rgba(255,255,255,.18); margin-bottom: 10px; }
  .scene { position: relative; perspective: 1700px; width: 420px; height: 560px; }
  .rond { width: 34px; height: 34px; border-radius: 50%; background: var(--f2); display: grid; place-items: center; color: #fff; font-weight: 700; }
  .scene :global(.chip) b { display: block; font-size: 14.5px; }
  .scene :global(.chip) small { display: block; font-size: 12.5px; color: var(--gris); }

  @media (max-width: 1100px) {
    .perdu { grid-template-columns: 1fr; min-height: 0; }
    .scene { zoom: .7; margin: 30px auto 0; }
  }
  @media (max-width: 700px) { .scene { zoom: .6; } }
</style>
