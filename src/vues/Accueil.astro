---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import Iphone3D from '../components/Iphone3D.astro';
import CarteFlottante from '../components/CarteFlottante.astro';
import Chiffres from '../components/Chiffres.astro';
import AppelFinal from '../components/AppelFinal.astro';
import Icone from '../components/Icone.astro';
import { lien, STUDIO } from '../config';
import { ecran } from '../lib/ecrans';
import { eventail, rangee } from '../data/produits';
import commun from '../i18n/commun';
import textes from '../i18n/accueil';
import type { Langue } from '../i18n/routes';

interface Props { langue: Langue }
const { langue } = Astro.props;
const t = textes[langue];
const c = commun[langue];
const v = t.methode.visuels;

const [derriere, devant] = eventail;
/** Icônes des services, dans l'ordre de `t.services.items`. */
const icones = ['cadrage', 'interface', 'mobile', 'web', 'donnees', 'suite'] as const;
/** Pastilles d'état des tranches, dans l'ordre de `v.tranches` : en ligne, en cours, prévue. */
const pastilles = ['background:#DDF3E6;color:#1F7A4D', 'background:#FFE7D6;color:var(--f1)', 'background:#EEEAF0;color:#6B6474'];
/** Rangée de la section sombre : téléphones resserrés, coupés à mi-hauteur par le bas de la section. */
const inclinaisons = [
  { w: 210, left: '15%', t: 'rotateY(18deg) rotateZ(-5deg) translateY(30px)' },
  { w: 230, left: '32%', t: 'rotateY(8deg) rotateZ(-2deg)' },
  { w: 230, left: '49%', t: 'rotateY(-8deg) rotateZ(2deg)' },
  { w: 210, left: '66%', t: 'rotateY(-18deg) rotateZ(5deg) translateY(30px)' },
];
---
<Base titre={`${STUDIO.nom} — ${c.accroche}`} description={c.description} suffixe={false} langue={langue} page="accueil">
  <Bande hauteur="780px" biais="58%" reserve="300px">
    <div class="hero w">
      <div>
        <span class="etiq">{t.etiquette}</span>
        <h1>{t.titre.gras}<br /><span class="leger">{t.titre.leger}</span></h1>
        <p class="sous">{t.sous}</p>
        <div class="boutons">
          <a class="btn btn--plein" href={lien('contact', langue)}>{c.cta}</a>
          <a class="btn btn--contour" href={lien('realisations', langue)}>{c.voirRealisations}</a>
        </div>
        <ul class="preuve">{t.preuve.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="scene" aria-hidden="true">
        <div class="ombre"></div>
        <Iphone3D ecran={ecran(derriere.projet, derriere.fichier, langue)} largeur={236} haut={derriere.haut} priorite style="left:40px;top:10px;transform:rotateY(24deg) rotateX(8deg) rotateZ(-9deg)" />
        <Iphone3D ecran={ecran(devant.projet, devant.fichier, langue)} largeur={278} haut={devant.haut} statut={devant.statut} priorite style="left:230px;top:70px;transform:rotateY(-20deg) rotateX(10deg) rotateZ(6deg);z-index:3" />
        <CarteFlottante classe="chip-chiens">
          <span class="rond">●</span>
          <span><b>{t.chipChiens.titre}</b><small>{t.chipChiens.sous}</small></span>
        </CarteFlottante>
        <CarteFlottante classe="chip-prix">
          <span class="valeur"><small>{t.chipPrix.estime}</small><b>{t.chipPrix.kwh.valeur}</b><small>{t.chipPrix.kwh.unite}</small></span>
          <span class="valeur"><small>{t.chipPrix.payer}</small><b>{t.chipPrix.prix.valeur}</b><small>{t.chipPrix.prix.unite}</small></span>
        </CarteFlottante>
      </div>
    </div>
  </Bande>

  <Chiffres elements={t.chiffres} />

  <section class="sec w creme">
    <h2 class="conv-titre"><span>{t.conviction.titre[0]}</span> <span set:html={t.conviction.titre[1]} /></h2>
    <div class="conv">
      <div>
        <ul class="couts">{t.conviction.couts.map((cout, i) => <li class={`c${i + 1}`}>{cout}</li>)}</ul>
        <p class="legende">{t.conviction.legende}</p>
      </div>
      <div class="conv-texte long">
        {t.conviction.paragraphes.map((p) => <p set:html={p} />)}
        <p class="chute">{t.conviction.chute}</p>
      </div>
    </div>
  </section>

  <section class="sec w">
    <div class="tete">
      <div>
        <h2 class="t2">{t.methode.titre}</h2>
        <p class="lead">{t.methode.lead}</p>
      </div>
      <a class="lien" href={lien('methode', langue)}>{t.methode.lien}</a>
    </div>
    <ol class="etapes">
      {t.methode.etapes.map((e, i) => (
        <li class="etape">
          {i === 0 && <div class="vis" aria-hidden="true"><div class="doc"><b>{v.note}</b><div class="ligne" style="width:92%"></div><div class="ligne" style="width:78%"></div><div class="ligne" style="width:86%"></div><div class="ligne" style="width:60%"></div><div class="corr">✎ {v.correction}</div></div></div>}
          {i === 1 && <div class="vis" aria-hidden="true"><div class="cols"><div style="background:var(--voile)"><b>{v.v1}</b>{v.v1Items.map((s) => <span>{s}</span>)}</div><div style="background:#F3F0EE"><b>{v.plusTard}</b>{v.plusTardItems.map((s) => <span>{s}</span>)}</div></div></div>}
          {i === 2 && <div class="vis" aria-hidden="true"><div class="mini"><Image src={ecran('teamago', 'Decompte', langue)} alt="" width={110} densities={[1, 2]} /></div><span class="bulle" style="left:14px;top:40px">{v.remonter}</span><span class="bulle" style="right:12px;top:130px;background:#1F8A5B">✓ {v.valide}</span></div>}
          {i === 3 && <div class="vis" aria-hidden="true"><div class="tranches">{v.tranches.map((tr, k) => <div><span>{tr.nom}</span><em style={pastilles[k]}>{tr.etat}</em></div>)}</div></div>}
          <p class="delai">{e.delai}</p>
          <h3>{e.titre}</h3>
          <p>{e.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="sec w sombre realisations">
    <div class="tete">
      <div>
        <h2 class="t2">{t.realisations.titre}</h2>
        <p class="lead">{t.realisations.lead}</p>
      </div>
      <a class="lien" href={lien('realisations', langue)}>{t.realisations.lien}</a>
    </div>
    <div class="rangee" aria-hidden="true">
      {rangee.map((e, i) => (
        <Iphone3D ecran={ecran(e.projet, e.fichier, langue)} largeur={inclinaisons[i]!.w} haut={e.haut} statut={e.statut} style={`left:${inclinaisons[i]!.left};top:20px;transform:${inclinaisons[i]!.t}`} />
      ))}
    </div>
  </section>

  <section class="sec w">
    <div class="duo">
      <div>
        <h2 class="t2">{t.experience.titre}</h2>
        <p class="lead">{t.experience.lead}</p>
        <p class="parcours-pro">{t.experience.parcours.map((etape, i) => <>{i > 0 && <i aria-hidden="true">→</i>}<span>{etape}</span></>)}</p>
        <a class="lien" href={lien('experience', langue)}>{t.experience.lien}</a>
      </div>
      <ul class="nuage">{t.experience.motsCles.map(([m, fort]) => <li class:list={[{ fort }]}>{m}</li>)}</ul>
    </div>
  </section>

  <section class="sec w creme">
    <div class="tete"><div><h2 class="t2">{t.services.titre}</h2><p class="lead">{t.services.lead}</p></div></div>
    <div class="grille-3">
      {t.services.items.map((s, i) => <article class="service"><div class="ico"><Icone nom={icones[i]!} /></div><h3>{s.titre}</h3><p>{s.texte}</p></article>)}
    </div>
  </section>

  <AppelFinal titre={t.appel.titre} texte={t.appel.texte} langue={langue} />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { display: grid; grid-template-columns: minmax(0, 580px) minmax(0, 1fr); gap: 24px; padding-top: 64px; min-height: 760px; }
  .hero h1 { margin-bottom: 24px; font-size: clamp(2.75rem, 7vw, 5rem); line-height: 1.02; font-weight: 800; letter-spacing: -.04em; }
  .hero h1 .leger { letter-spacing: -.035em; }
  .sous { margin-bottom: 34px; max-width: 500px; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); font-weight: 500; line-height: 1.55; color: rgba(255,255,255,.86); }
  .preuve { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13.5px; color: rgba(255,255,255,.82); }
  .preuve li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 8px; vertical-align: middle; background: currentColor; }

  .scene { position: relative; perspective: 1700px; width: 560px; height: 760px; }
  .ombre { position: absolute; left: 150px; top: 720px; width: 360px; height: 60px; border-radius: 50%; filter: blur(28px); background: rgba(40, 14, 6, .32); }
  .scene :global(.chip-chiens) { left: -40px; top: 420px; }
  .scene :global(.chip-prix) { left: 470px; top: 250px; gap: 18px; }
  .rond { width: 34px; height: 34px; border-radius: 50%; background: #0E7C6B; display: grid; place-items: center; color: #fff; font-size: 13px; }
  .scene :global(.chip) b { display: block; font-size: 14.5px; color: #12161c; }
  .scene :global(.chip) small { display: block; font-size: 12.5px; color: #6b7280; }
  .valeur small { font-size: 10px !important; letter-spacing: .12em; color: #8a7f73 !important; }
  .valeur small:last-child { font-size: 11px !important; letter-spacing: 0; white-space: nowrap; }
  .valeur b { font: 500 24px Georgia, serif !important; color: #1d1a16 !important; }

  /* ---------- conviction ---------- */
  .conv-titre { font-size: clamp(2rem, 6vw, 4.5rem); line-height: 1; letter-spacing: -.045em; font-weight: 800; margin-bottom: clamp(40px, 5vw, 64px); }
  .conv-titre span { display: block; }
  .conv-titre span + span { color: var(--f2); }
  .conv { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; align-items: start; }
  .couts { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; }
  .couts li { min-height: 58px; border-radius: 16px; display: flex; align-items: center; padding: 10px 20px; font-weight: 700; font-size: 15px; }
  .couts .c1 { width: 42%; background: var(--voile); color: var(--f1); }
  .couts .c2 { width: 70%; background: #F6C3A6; color: var(--f1); }
  .couts .c3 { width: 100%; background: linear-gradient(90deg, var(--f2), var(--f1)); color: #fff; }
  .legende { font-size: 13px; color: var(--gris); margin-top: 16px; }
  .conv-texte p { font-size: 18.5px; line-height: 1.7; color: var(--encre-2); margin-bottom: 22px; }
  .conv-texte strong { color: var(--encre); font-weight: 700; }
  .conv-texte .chute { margin: 34px 0 0; padding: 26px 28px; border-radius: 22px; background: var(--encre); color: #fff; font-size: 21px; line-height: 1.45; font-weight: 700; letter-spacing: -.015em; }

  /* ---------- méthode : quatre cartes, chacune montre son livrable ---------- */
  .etapes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .etape { background: var(--creme); border-radius: 26px; padding: 22px; display: flex; flex-direction: column; }
  .vis { height: 190px; border-radius: 18px; background: #fff; margin-bottom: 22px; position: relative; overflow: hidden; box-shadow: 0 1px 2px rgba(21,18,31,.05); }
  .delai { font-size: 12.5px; font-weight: 700; color: var(--f2); margin-bottom: 8px; }
  .etape h3 { font-size: 23px; letter-spacing: -.025em; font-weight: 800; margin-bottom: 10px; }
  .etape > p:last-child { font-size: 14.5px; line-height: 1.55; color: var(--encre-2); }
  .doc { position: absolute; inset: 18px 22px auto; background: #fff; border: 1px solid var(--trait); border-radius: 12px; padding: 14px; font-family: var(--ui); font-size: 11px; }
  .doc b { font-size: 12.5px; display: block; margin-bottom: 8px; }
  .ligne { height: 6px; border-radius: 3px; background: #EFE9E4; margin-bottom: 7px; }
  .corr { background: #FFE7D6; color: var(--f1); border-radius: 6px; padding: 5px 7px; font-size: 10.5px; margin-top: 8px; }
  .cols { position: absolute; inset: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-family: var(--ui); }
  .cols div { border-radius: 12px; padding: 10px; font-size: 10.5px; display: flex; flex-direction: column; gap: 6px; }
  .cols b { font-size: 11.5px; margin-bottom: 2px; }
  .cols span { background: #fff; border-radius: 7px; padding: 5px 7px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .mini { position: absolute; left: 50%; top: 18px; width: 110px; height: 240px; transform: translateX(-50%); border-radius: 22px; background: #111; padding: 4px; }
  .mini :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 18px; }
  .bulle { position: absolute; font: 600 11px var(--ui); padding: 7px 10px; border-radius: 12px; background: var(--encre); color: #fff; box-shadow: 0 10px 20px -8px rgba(0,0,0,.4); }
  .tranches { position: absolute; inset: 22px; display: grid; gap: 8px; font-family: var(--ui); font-size: 11.5px; }
  .tranches div { display: flex; justify-content: space-between; align-items: center; gap: 6px; border-radius: 10px; padding: 9px 11px; background: var(--creme); }
  .tranches em { font-style: normal; font-weight: 600; font-size: 10.5px; padding: 3px 8px; border-radius: 99px; white-space: nowrap; }

  /* ---------- réalisations (sombre) ---------- */
  .realisations { padding-bottom: 0; overflow: hidden; }
  .rangee { position: relative; height: 300px; margin-top: 10px; perspective: 1800px; }

  /* ---------- expérience ---------- */
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
  .parcours-pro { display: flex; gap: 10px; align-items: center; margin: 30px 0 34px; font-weight: 700; font-size: 15px; flex-wrap: wrap; }
  .parcours-pro i { font-style: normal; color: var(--gris); font-weight: 500; }
  .nuage { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .nuage li { font-size: 14.5px; font-weight: 600; padding: 11px 16px; border-radius: 99px; background: var(--creme); border: 1px solid var(--trait); }
  .nuage li.fort { background: var(--voile); border-color: #F5D3C2; color: var(--f1); }

  /* ---------- périmètre ---------- */
  .service { border: 1px solid var(--trait); border-radius: 22px; padding: 26px; background: #fff; }
  .service h3 { font-size: 19px; font-weight: 800; letter-spacing: -.02em; margin-bottom: 8px; }
  .service p { font-size: 14.5px; line-height: 1.55; color: var(--encre-2); }

  /* ---------- adaptation ---------- */
  @media (max-width: 1360px) { .scene { zoom: .92; } }
  @media (max-width: 1240px) { .scene { zoom: .84; } }
  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .scene { zoom: .8; margin: 40px auto 0; }
    .conv, .duo { grid-template-columns: 1fr; gap: 48px; }
    .etapes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rangee { zoom: .8; }
  }
  @media (max-width: 700px) {
    .scene { zoom: .56; }
    .scene :global(.chip-chiens) { left: 0; }
    .scene :global(.chip-prix) { left: 330px; top: 520px; }
    .etapes { grid-template-columns: 1fr; }
    .rangee { zoom: .5; height: 320px; }
    .couts .c1, .couts .c2 { width: 100%; }
  }
  @media (max-width: 380px) { .scene { zoom: .48; } .scene :global(.chip-prix) { left: 280px; } }
</style>
