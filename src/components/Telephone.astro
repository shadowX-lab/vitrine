---
import { Image } from 'astro:assets';
import { ecran } from '../data/produits';

interface Props {
  projet: string;
  fichier: string;
  alt: string;
  /** Largeur rendue, en pixels CSS. */
  largeur?: number;
  charge?: 'eager' | 'lazy';
}

const { projet, fichier, alt, largeur = 268, charge = 'lazy' } = Astro.props;
const source = ecran(projet, fichier);
---

<div class="tel" style={`max-width:${largeur}px`}>
  <Image src={source} alt={alt} width={largeur * 2} densities={[1, 2]} loading={charge} />
</div>
