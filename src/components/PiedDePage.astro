---
import { lien, equivalent, STUDIO } from '../config';
import commun from '../i18n/commun';
import { LANGUES, NOMS_LANGUES, type Langue, type Page } from '../i18n/routes';
interface Props { langue: Langue; page?: Page; slug?: string }
const { langue, page, slug } = Astro.props;
const c = commun[langue];
---
<footer class="pied">
  <div>
    <a class="logo" href={lien('accueil', langue)} translate="no">{STUDIO.nom}</a>
    <p>{c.pied.phrase}</p>
  </div>
  <nav aria-label={c.pied.aria} class="colonnes">
    <div><h2>{c.pied.travail}</h2><ul><li><a href={lien('methode', langue)}>{c.nav.methode}</a></li><li><a href={lien('realisations', langue)}>{c.nav.realisations}</a></li></ul></div>
    <div><h2>{c.pied.studio}</h2><ul><li><a href={lien('experience', langue)}>{c.nav.experience}</a></li><li><a href={lien('contact', langue)}>{c.pied.contact}</a></li></ul></div>
  </nav>
  <div class="bas">
    <span>© {new Date().getFullYear()} {STUDIO.nom} · {c.pied.base}</span>
    <span class="droite">
      <nav class="langues-pied" aria-label={c.langue.pied}>
        {LANGUES.map((l, i) => (
          <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={equivalent(l, page, slug)} lang={l} hreflang={l} aria-current={l === langue ? 'true' : undefined}>{NOMS_LANGUES[l]}</a></>
        ))}
      </nav>
      <a href={lien('mentions', langue)}>{c.pied.mentions}</a>
    </span>
  </div>
</footer>

<style>
  .pied { background: var(--encre); color: #fff; padding: 64px var(--gouttiere) 36px; display: grid; grid-template-columns: 1.4fr 2fr; gap: 40px; font-size: 14.5px; }
  .logo { display: block; font-weight: 800; font-size: 24px; letter-spacing: -.035em; margin-bottom: 10px; }
  p { color: #B9B2BF; max-width: 36ch; line-height: 1.6; }
  .colonnes { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  h2 { font-size: 13px; color: var(--f3); margin-bottom: 14px; font-weight: 700; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; color: #DCD6E0; }
  a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .bas { grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,.1); padding-top: 22px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: #8F8896; font-size: 13px; }
  .droite { display: flex; gap: 22px; flex-wrap: wrap; }
  .langues-pied a[aria-current='true'] { color: #fff; font-weight: 700; }
  @media (max-width: 700px) { .pied { grid-template-columns: 1fr; } }
</style>
