---
import { lien, STUDIO } from '../config';
import { produits } from '../data/produits';
---

<footer class="pied">
  <div class="page">
    <div class="pied__haut">
      <div>
        <p class="pied__accroche">{STUDIO.accroche}.</p>
        <p class="pied__texte">{STUDIO.description}</p>
      </div>

      <nav class="pied__colonnes" aria-label="Navigation de pied de page">
        <div>
          <h2>Studio</h2>
          <ul>
            <li><a href={lien('/methode')}>Méthode</a></li>
            <li><a href={lien('/studio')}>Le studio</a></li>
            <li><a href={lien('/contact')}>Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Produits</h2>
          <ul>
            {produits.map((p) => (
              <li><a href={lien(`/produits/${p.slug}`)}>{p.nom}</a></li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <div class="graduation graduation--haute" aria-hidden="true"></div>

    <div class="pied__bas">
      <p>© {new Date().getFullYear()} {STUDIO.nom}</p>
      <a href={lien('/mentions-legales')}>Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .pied {
    background: var(--encre);
    color: var(--papier);
    --trait: rgba(247, 244, 238, 0.18);
    --trait-fin: rgba(247, 244, 238, 0.09);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: 2rem;
  }

  .pied__haut {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .pied__accroche {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }
  .pied__texte { color: #b6bac1; max-width: 44ch; font-size: 0.98rem; }

  .pied__colonnes { display: flex; gap: clamp(2rem, 6vw, 4.5rem); }
  .pied__colonnes h2 {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--laiton);
    margin-bottom: 1rem;
  }
  .pied__colonnes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .pied__colonnes a {
    text-decoration: none;
    color: #d4d7dc;
    font-size: 0.95rem;
    transition: color 0.16s;
  }
  .pied__colonnes a:hover { color: var(--papier); }

  .pied__bas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.6rem;
    font-size: 0.85rem;
    color: #8f949c;
  }
  .pied__bas p { margin: 0; }
  .pied__bas a { color: inherit; text-decoration: none; }
  .pied__bas a:hover { color: var(--papier); }

  @media (max-width: 760px) {
    .pied__haut { grid-template-columns: 1fr; }
  }
</style>
