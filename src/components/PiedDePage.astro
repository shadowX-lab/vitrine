---
import { lien, STUDIO } from '../config';
---

<footer class="pied">
  <div class="page">
    <div class="pied__haut">
      <div>
        <p class="pied__accroche">{STUDIO.accroche}.</p>
        <p class="pied__texte">{STUDIO.description}</p>
      </div>

      <nav class="pied__colonnes" aria-label="Navigation de pied de page">
        <div>
          <h2>Le travail</h2>
          <ul>
            <li><a href={lien('/methode')}>Méthode</a></li>
            <li><a href={lien('/realisations')}>Réalisations</a></li>
          </ul>
        </div>
        <div>
          <h2>La maison</h2>
          <ul>
            <li><a href={lien('/experience')}>Expérience</a></li>
            <li><a href={lien('/contact')}>Contact</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="liseret" aria-hidden="true"></div>

    <div class="pied__bas">
      <p>© {new Date().getFullYear()} {STUDIO.nom} · Basé à {STUDIO.ville}, au travail partout</p>
      <a href={lien('/mentions-legales')}>Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .pied {
    background: var(--encre);
    color: var(--papier);
    --trait: rgba(251, 249, 245, 0.16);
    --trait-fin: rgba(251, 249, 245, 0.08);
    --bronze: #c79a5f;
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: 2rem;
  }

  .pied__haut {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .pied__accroche {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    margin-bottom: 0.8rem;
  }
  .pied__texte { color: #b3b9c2; max-width: 46ch; font-size: 0.95rem; }

  .pied__colonnes { display: flex; gap: clamp(2rem, 6vw, 4.5rem); }
  .pied__colonnes h2 {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c79a5f;
    margin-bottom: 1.1rem;
  }
  .pied__colonnes ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .pied__colonnes a {
    text-decoration: none;
    color: #d2d6dc;
    font-size: 0.925rem;
    transition: color 0.16s;
  }
  .pied__colonnes a:hover { color: var(--papier); }

  .pied__bas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.7rem;
    font-size: 0.83rem;
    color: #8d939c;
  }
  .pied__bas p { margin: 0; }
  .pied__bas a { color: inherit; text-decoration: none; }
  .pied__bas a:hover { color: var(--papier); }

  @media (max-width: 760px) {
    .pied__haut { grid-template-columns: 1fr; }
  }
</style>
