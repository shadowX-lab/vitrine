---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import Iphone3D from '../components/Iphone3D.astro';
import CarteFlottante from '../components/CarteFlottante.astro';
import { lien } from '../config';
import { ecran } from '../lib/ecrans';
---
<Base titre="Page introuvable" description="Cette page n'existe pas." langue="fr" indexer={false}>
  <Bande hauteur="820px" biais="64%" reserve="220px">
    <div class="perdu w">
      <div>
        <p class="code" aria-hidden="true">404</p>
        <h1>Cette page n'existe pas</h1>
        <p class="sous">Un lien cassé, une adresse mal recopiée, ou une page qu'on a retirée. Dans les trois cas, ce n'est pas votre faute.</p>
        <div class="boutons">
          <a class="btn btn--plein" href={lien('accueil', 'fr')}>Retour à l'accueil</a>
          <a class="btn btn--contour" href={lien('realisations', 'fr')}>Voir les réalisations</a>
        </div>
      </div>
      <div class="scene" aria-hidden="true">
        <Iphone3D ecran={ecran('pilpoil', 'Carte')} largeur={250} haut="#F4F5F4" priorite style="left:120px;top:0;transform:rotateY(-20deg) rotateX(10deg) rotateZ(7deg)" />
        <CarteFlottante style="left:30px;top:300px">
          <span class="rond">?</span>
          <span><b>Aucun résultat ici</b><small>Essayez plutôt l'accueil</small></span>
        </CarteFlottante>
      </div>
    </div>
  </Bande>
</Base>

<style>
  .perdu { display: grid; grid-template-columns: minmax(0, 640px) minmax(0, 1fr); gap: 40px; padding-top: 70px; min-height: 780px; }
  .code { font-size: clamp(8rem, 18vw, 13.75rem); line-height: .8; letter-spacing: -.07em; font-weight: 800; color: rgba(255,255,255,.18); margin-bottom: 10px; }
  .scene { position: relative; perspective: 1700px; width: 420px; height: 560px; }
  .rond { width: 34px; height: 34px; border-radius: 50%; background: var(--f2); display: grid; place-items: center; color: #fff; font-weight: 700; }
  .scene :global(.chip) b { display: block; font-size: 14.5px; }
  .scene :global(.chip) small { display: block; font-size: 12.5px; color: var(--gris); }

  @media (max-width: 1100px) {
    .perdu { grid-template-columns: 1fr; min-height: 0; }
    .scene { zoom: .7; margin: 30px auto 0; }
  }
  @media (max-width: 700px) { .scene { zoom: .6; } }
</style>
