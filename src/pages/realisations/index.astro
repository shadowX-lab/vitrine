---
import Base from '../../layouts/Base.astro';
import Telephone from '../../components/Telephone.astro';
import AppelAction from '../../components/AppelAction.astro';
import { lien } from '../../config';
import { produits } from '../../data/produits';
---

<Base
  titre="Réalisations"
  description="Des applications conçues et construites de bout en bout : le problème, les décisions qui ont tout changé, et les écrans qui en sont sortis."
>
  <section class="ouverture">
    <div class="page">
      <p class="eyebrow">Réalisations</p>
      <h1>Ce que ça donne,<br />et <em>pourquoi</em></h1>
      <p class="chapeau">
        Ce ne sont pas des références clients : ce sont mes produits, et je le
        dis. C'est précisément ce qui les rend utiles à regarder — je peux vous
        montrer les arbitrages, leurs raisons, et ce que j'ai délibérément laissé
        de côté. Une prestation ne montre jamais ça.
      </p>
    </div>
  </section>

  <div class="liseret" aria-hidden="true"></div>

  <section class="section">
    <div class="page liste">
      {produits.map((p, i) => (
        <article
          class="produit apparait"
          style={`--teinte:${p.palette.accent};--voile:${p.palette.voile};--contraste:${p.palette.contraste}`}
        >
          <div class="produit__visuel">
            <Telephone
              projet={p.slug}
              fichier={p.heros}
              alt={`${p.nom} — écran principal`}
              largeur={224}
              charge={i === 0 ? 'eager' : 'lazy'}
            />
            <Telephone projet={p.slug} fichier={p.parcours[0]!.fichier} alt="" largeur={192} />
          </div>

          <div class="produit__corps">
            <p class="produit__domaine">{p.domaine}</p>
            <h2>{p.nom}</h2>
            <p class="produit__baseline">{p.baseline}</p>
            <p class="prose">{p.resume}</p>

            <ul class="produit__points">
              {p.decisions.map((d) => <li>{d.titre}</li>)}
            </ul>

            <a class="bouton" href={lien(`/realisations/${p.slug}`)}>Lire l'étude de cas</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <AppelAction />
</Base>

<style>
  .ouverture { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); }
  .ouverture h1 { margin-bottom: 1.6rem; }
  .ouverture h1 em { font-style: italic; color: var(--bronze); }

  .liste { display: grid; gap: clamp(3.5rem, 8vw, 7rem); }

  .produit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .produit:nth-child(even) .produit__visuel { order: 2; }

  .produit__visuel {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.5rem, 2vw, 1.4rem);
    background: var(--voile);
    border-radius: var(--arrondi-l);
    padding: clamp(2rem, 4vw, 3.2rem) 1rem 0;
    overflow: hidden;
  }
  .produit__visuel :global(.tel):first-child { margin-bottom: -2.5rem; z-index: 2; }
  .produit__visuel :global(.tel):last-child { margin-bottom: -4.5rem; opacity: 0.9; }

  .produit__domaine {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--contraste);
    margin-bottom: 1rem;
  }
  .produit h2 { color: var(--contraste); margin-bottom: 0.45rem; }
  .produit__baseline {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.24;
    margin-bottom: 1.2rem;
  }
  .produit .prose { margin-bottom: 1.7rem; }

  .produit__points { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; gap: 0; }
  .produit__points li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--trait-fin);
    font-size: 0.94rem;
    color: var(--encre-douce);
    display: flex;
    gap: 0.75rem;
  }
  .produit__points li::before {
    content: '';
    width: 5px; height: 5px;
    background: var(--teinte);
    flex: none;
    transform: translateY(0.66rem) rotate(45deg);
  }
  .produit__points li:last-child { border-bottom: 1px solid var(--trait-fin); }

  @media (max-width: 900px) {
    .produit { grid-template-columns: 1fr; }
    .produit:nth-child(even) .produit__visuel { order: 0; }
  }
</style>
