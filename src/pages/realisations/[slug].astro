---
import Base from '../../layouts/Base.astro';
import Telephone from '../../components/Telephone.astro';
import AppelAction from '../../components/AppelAction.astro';
import { lien } from '../../config';
import { produits, type Produit } from '../../data/produits';

export function getStaticPaths() {
  return produits.map((produit) => ({
    params: { slug: produit.slug },
    props: { produit },
  }));
}

interface Props { produit: Produit }
const { produit } = Astro.props;

const index = produits.findIndex((p) => p.slug === produit.slug);
const suivant = produits[(index + 1) % produits.length]!;
---

<Base titre={`${produit.nom} — ${produit.baseline}`} description={produit.resume}>
  <article
    class="etude"
    style={`--teinte:${produit.palette.accent};--voile:${produit.palette.voile};--contraste:${produit.palette.contraste}`}
  >
    <header class="ouverture">
      <div class="page ouverture__interieur">
        <div>
          <p class="fil"><a href={lien('/realisations')}>Réalisations</a> <span aria-hidden="true">/</span> {produit.nom}</p>
          <p class="etiquette">Produit maison</p>
          <h1>{produit.nom}</h1>
          <p class="ouverture__baseline">{produit.baseline}</p>
          <p class="chapeau">{produit.resume}</p>

          <dl class="fiche">
            <div><dt>Domaine</dt><dd>{produit.domaine}</dd></div>
            <div><dt>Plateforme</dt><dd>{produit.plateforme}</dd></div>
            <div><dt>Année</dt><dd>{produit.annee}</dd></div>
            <div>
              <dt>Code</dt>
              <dd>
                {produit.depot
                  ? <a href={produit.depot} target="_blank" rel="noopener">Dépôt public</a>
                  : 'Dépôt privé'}
              </dd>
            </div>
          </dl>
        </div>

        <div class="ouverture__visuel">
          <Telephone
            projet={produit.slug}
            fichier={produit.heros}
            alt={`${produit.nom} — écran principal`}
            largeur={286}
            charge="eager"
          />
        </div>
      </div>
    </header>

    <div class="liseret" aria-hidden="true"></div>

    <!-- ===== Chiffres ===== -->
    <section class="section chiffres">
      <div class="page">
        <ul>
          {produit.chiffres.map((c) => (
            <li>
              <span class="chiffre">{c.valeur}</span>
              <span>{c.libelle}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Le problème ===== -->
    <section class="section section--creux">
      <div class="page deux-colonnes">
        <div>
          <p class="eyebrow">Le point de départ</p>
          <h2>Le problème</h2>
        </div>
        <div class="prose grand">
          {produit.probleme.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- ===== Le parcours en quatre écrans ===== -->
    <section class="section parcours-section">
      <div class="page">
        <div class="deux-colonnes deux-colonnes--titre">
          <div>
            <p class="eyebrow">En un coup d'œil</p>
            <h2>Comment ça se vit</h2>
          </div>
          <p class="prose">
            Quatre écrans suffisent à comprendre. Le reste de l'application
            existe, mais elle n'a pas besoin d'être récitée pour se juger.
          </p>
        </div>

        <ol class="parcours">
          {produit.parcours.map((e) => (
            <Fragment>
              <li class="parcours__etape apparait">
                <Telephone projet={produit.slug} fichier={e.fichier} alt={`${produit.nom} — ${e.titre}`} largeur={210} />
                <div class="parcours__legende">
                  <h3>{e.titre}</h3>
                  <p>{e.texte}</p>
                </div>
              </li>
              {e.suite && (
                <li class="parcours__lien" aria-hidden="true">
                  <svg width="30" height="10" viewBox="0 0 30 10" fill="none">
                    <path d="M0 5h27M23 1l4.5 4-4.5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <em>{e.suite}</em>
                </li>
              )}
            </Fragment>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Décisions ===== -->
    <section class="section">
      <div class="page">
        <div class="deux-colonnes deux-colonnes--titre">
          <div>
            <p class="eyebrow">Ce qui a été tranché</p>
            <h2>Les décisions</h2>
          </div>
          <p class="prose">
            Chacune a été écrite et argumentée <strong>avant</strong> le premier
            écran. C'est ce travail-là qui rend la suite rapide : quand la
            question revient six mois plus tard, la réponse est déjà quelque
            part, avec sa raison.
          </p>
        </div>

        <ol class="decisions">
          {produit.decisions.map((d, i) => (
            <li class="apparait">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{d.titre}</h3>
                <p>{d.texte}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Livrables ===== -->
    <section class="section section--creux">
      <div class="page deux-colonnes">
        <div>
          <p class="eyebrow">Ce qui a été produit</p>
          <h2>Livrables</h2>
        </div>
        <ul class="livrables">
          {produit.livre.map((l) => (
            <li>
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {l}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section suivant">
      <div class="page">
        <a href={lien(`/realisations/${suivant.slug}`)} style={`--teinte:${suivant.palette.accent}`}>
          <div>
            <p class="eyebrow">À voir ensuite</p>
            <h2>{suivant.nom}</h2>
            <p>{suivant.baseline}</p>
          </div>
          <svg width="34" height="24" viewBox="0 0 17 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10.5 1L15.5 6l-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>
  </article>

  <AppelAction
    titre="Un produit à cadrer ?"
    texte="C'est exactement le travail que vous venez de voir, appliqué au vôtre. Le premier entretien ne vous engage à rien, et vous repartez avec une note écrite de ce que j'ai compris."
  />
</Base>

<style>
  .ouverture { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem); background: var(--voile); }
  .ouverture__interieur {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .fil { font-size: 0.85rem; color: var(--gris); margin-bottom: 1.6rem; }
  .fil a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--trait); }
  .fil a:hover { color: var(--encre); }
  .fil span { margin-inline: 0.4rem; opacity: 0.5; }

  .etiquette {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--contraste);
    border: 1px solid color-mix(in srgb, var(--teinte) 38%, transparent);
    border-radius: 100px;
    padding: 0.34rem 0.85rem;
    margin-bottom: 1.2rem;
  }

  .ouverture h1 { color: var(--contraste); margin-bottom: 0.5rem; }
  .ouverture__baseline {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    line-height: 1.22;
    margin-bottom: 1.4rem;
  }
  .ouverture .chapeau { color: var(--encre-douce); max-width: 46ch; }

  .fiche {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1.2rem;
    margin: 2.4rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--teinte) 24%, transparent);
  }
  .fiche dt {
    font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--gris); margin-bottom: 0.4rem;
  }
  .fiche dd { margin: 0; font-size: 0.9rem; font-weight: 450; }
  .fiche a { color: var(--contraste); text-underline-offset: 3px; }

  .ouverture__visuel { display: flex; justify-content: center; }

  /* ---------- chiffres ---------- */
  .chiffres { padding-block: clamp(2.5rem, 5vw, 3.75rem); }
  .chiffres ul {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .chiffres li { display: grid; gap: 0.6rem; border-top: 1px solid var(--trait); padding-top: 1.25rem; }
  .chiffres .chiffre { color: var(--contraste); }
  .chiffres span:last-child { color: var(--gris); font-size: 0.88rem; max-width: 26ch; }

  .deux-colonnes {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .deux-colonnes--titre { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); align-items: end; }
  .prose.grand { font-size: 1.06rem; }
  .eyebrow::before { background: var(--teinte); }

  /* ---------- parcours : quatre écrans, des flèches entre eux ---------- */
  .parcours-section { background: var(--voile); }
  /* Les flèches sont de vrais éléments de la rangée : elles ne peuvent donc
     pas recouvrir un écran, quelle que soit la largeur disponible. */
  .parcours {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(0.4rem, 1vw, 0.9rem);
  }
  .parcours__etape {
    flex: 1 1 0;
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
  }
  .parcours__legende { text-align: center; max-width: 28ch; }
  .parcours__legende h3 {
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    color: var(--contraste);
    margin-bottom: 0.45rem;
  }
  .parcours__legende p { font-size: 0.85rem; color: var(--encre-douce); line-height: 1.5; margin: 0; }

  .parcours__lien {
    flex: 0 0 clamp(4rem, 6.5vw, 6rem);
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    color: var(--teinte);
    padding-top: clamp(4.5rem, 13vw, 11rem);
  }
  .parcours__lien em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.8rem;
    line-height: 1.3;
    text-align: center;
    color: var(--contraste);
  }

  /* ---------- décisions ---------- */
  .decisions { list-style: none; margin: 0; padding: 0; display: grid; }
  .decisions li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.8rem, 3vw, 2.5rem);
    border-top: 1px solid var(--trait);
  }
  .decisions li:last-child { border-bottom: 1px solid var(--trait); }
  .decisions .index { color: var(--contraste); }
  .decisions h3 { margin-bottom: 0.8rem; max-width: 26ch; }
  .decisions p { color: var(--encre-douce); max-width: 66ch; margin: 0; }

  /* ---------- livrables ---------- */
  .livrables { list-style: none; margin: 0; padding: 0; display: grid; align-content: start; }
  .livrables li {
    display: flex; align-items: baseline; gap: 0.9rem;
    padding-block: 1rem; border-bottom: 1px solid var(--trait);
    font-size: 1rem;
  }
  .livrables li:first-child { border-top: 1px solid var(--trait); }
  .livrables svg { color: var(--teinte); flex: none; transform: translateY(2px); }

  /* ---------- suivant ---------- */
  .suivant a {
    display: flex; justify-content: space-between; align-items: center; gap: 2rem;
    text-decoration: none;
    border-top: 1px solid var(--trait); border-bottom: 1px solid var(--trait);
    padding-block: clamp(2rem, 4vw, 3rem);
    transition: color 0.22s;
  }
  .suivant a:hover { color: var(--teinte); }
  .suivant h2 { margin-bottom: 0.4rem; }
  .suivant p:last-child { color: var(--gris); }
  .suivant svg { flex: none; transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1); }
  .suivant a:hover svg { transform: translateX(8px); }

  /* Sous 1080 px, la rangée devient une grille : les flèches n'ont plus
     de place et disparaissent, l'ordre de lecture suffit. */
  @media (max-width: 1080px) {
    .parcours { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 2.4rem); }
    .parcours__lien { display: none; }
  }
  @media (max-width: 900px) {
    .ouverture__interieur, .deux-colonnes { grid-template-columns: 1fr; }
    .decisions li { grid-template-columns: 1fr; gap: 0.8rem; }
  }
  @media (max-width: 620px) {
    .parcours { grid-template-columns: 1fr; }
  }
</style>
