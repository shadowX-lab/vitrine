---
import Base from '../layouts/Base.astro';
import Telephone from '../components/Telephone.astro';
import AppelAction from '../components/AppelAction.astro';
import { lien, STUDIO } from '../config';
import { eventail, rangee } from '../data/produits';

const etapes = [
  {
    titre: 'Écouter',
    texte:
      "Un entretien, sans grille de questions toute faite. Il en sort une note écrite de votre problème, telle qu'on l'a comprise — et vous la corrigez. Tant qu'elle sonne faux, rien ne commence.",
    livrable: 'Note de cadrage',
    delai: 'Sous une semaine',
  },
  {
    titre: 'Cadrer',
    texte:
      "On réduit le problème à ce qui compte vraiment. Ce qui entre dans la première version, ce qui attend, et pourquoi. Chaque arbitrage est écrit avec sa raison.",
    livrable: 'Périmètre arbitré',
    delai: 'Une à deux semaines',
  },
  {
    titre: 'Valider',
    texte:
      "Des écrans réels, pas des boîtes grises. On les regarde ensemble, vous les annotez, et rien ne part en développement avant votre feu vert. La maquette est le contrat.",
    livrable: 'Maquettes cliquables',
    delai: 'Quelques jours par parcours',
  },
  {
    titre: 'Construire',
    texte:
      "Par tranches complètes, livrées une par une. Chaque tranche fonctionne de bout en bout : vous ne verrez jamais soixante pour cent d'une fonctionnalité.",
    livrable: 'Application en ligne',
    delai: 'Au rythme des tranches',
  },
];
---

<Base
  titre={`${STUDIO.nom} — ${STUDIO.accroche}`}
  description={STUDIO.description}
  suffixe={false}
>
  <!-- ================= Hero ================= -->
  <section class="hero">
    <div class="page hero__interieur">
      <div class="hero__texte">
        <p class="eyebrow">Conception &amp; développement · web et mobile</p>
        <h1>Le produit<br />avant <em>le code</em>.</h1>
        <p class="chapeau">
          La plupart des applications qui échouent ont été très bien
          développées. Elles répondaient simplement aux mauvaises questions.
          On commence par celles-là.
        </p>
        <div class="hero__boutons">
          <a class="bouton" href={lien('/contact')}>Parlons de votre projet</a>
          <a class="fleche" href={lien('/methode')}>
            Comment ça se passe
            <svg width="17" height="12" viewBox="0 0 17 12" fill="none" aria-hidden="true">
              <path d="M1 6h14M10.5 1L15.5 6l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Décoratif : aucun nom d'application n'y figure, rien à annoncer. -->
      <div class="hero__eventail" aria-hidden="true">
        <div class="hero__tel hero__tel--gauche">
          <Telephone {...eventail[0]!} alt="" largeur={198} charge="eager" />
        </div>
        <div class="hero__tel hero__tel--droite">
          <Telephone {...eventail[2]!} alt="" largeur={198} charge="eager" />
        </div>
        <div class="hero__tel hero__tel--avant">
          <Telephone {...eventail[1]!} alt="" largeur={232} charge="eager" />
        </div>
      </div>
    </div>
  </section>

  <div class="liseret" aria-hidden="true"></div>

  <!-- ================= Bandeau ================= -->
  <section class="section bandeau">
    <div class="page bandeau__grille">
      <p class="bandeau__phrase">
        Quinze ans à concevoir et à construire des produits, en petite structure
        comme en grand groupe. C'est ce que vous achetez.
      </p>
      <ul class="bandeau__liste">
        <li>
          <span class="chiffre">15</span>
          <span>ans d'expérience, du développement au pilotage produit</span>
        </li>
        <li>
          <span class="chiffre">1</span>
          <span>seul interlocuteur, du premier entretien à la mise en ligne</span>
        </li>
        <li>
          <span class="chiffre">0</span>
          <span>ligne de code écrite avant un écran que vous avez validé</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= Conviction ================= -->
  <section class="section section--creux">
    <div class="page conviction">
      <div>
        <p class="eyebrow">La conviction</p>
        <h2>Le code n'est pas le sujet.<br />Il est la conséquence.</h2>
      </div>
      <div class="prose conviction__texte">
        <p>
          Une fonctionnalité mal cadrée ne coûte pas seulement son
          développement. Elle coûte son développement, puis son retrait, puis la
          confiance de ceux qui s'en servaient. <strong>C'est le poste de dépense
          le plus lourd d'un projet, et personne ne le facture.</strong>
        </p>
        <p>
          Alors on prend le temps au début, là où il est bon marché. On cherche
          d'abord à comprendre votre métier, avant de vous proposer quoi que ce
          soit. On tranche ensemble ce qui entre dans la première version. Les
          écrans sont dessinés, vous les corrigez, et rien ne se construit qui
          n'ait été validé.
        </p>
        <p>Ensuite, oui, ça va vite — parce que la question difficile est déjà réglée.</p>
      </div>
    </div>
  </section>

  <!-- ================= Méthode ================= -->
  <section class="section">
    <div class="page">
      <div class="titre-section">
        <div>
          <p class="eyebrow">La méthode</p>
          <h2>Quatre temps, dans cet ordre</h2>
        </div>
        <a class="fleche" href={lien('/methode')}>
          La méthode en détail
          <svg width="17" height="12" viewBox="0 0 17 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10.5 1L15.5 6l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <ol class="etapes">
        {etapes.map((e, i) => (
          <li class="etape apparait">
            <span class="index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
            <dl class="etape__meta">
              <div><dt>Livrable</dt><dd>{e.livrable}</dd></div>
              <div><dt>Délai</dt><dd>{e.delai}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= Aperçu du travail, sans rien dévoiler ================= -->
  <section class="section section--creux">
    <div class="page">
      <div class="titre-section">
        <div>
          <p class="eyebrow">Le travail</p>
          <h2>Le soin se voit<br />avant de s'expliquer</h2>
        </div>
        <a class="fleche" href={lien('/realisations')}>
          Voir les réalisations
          <svg width="17" height="12" viewBox="0 0 17 12" fill="none" aria-hidden="true">
            <path d="M1 6h14M10.5 1L15.5 6l-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <p class="prose introduction">
        Un utilisateur ne peut pas juger votre architecture. Il juge l'alignement
        d'un chiffre, la formulation d'un message d'erreur, le temps que met un
        écran à s'afficher — et il en déduit, souvent avec raison, la qualité de
        tout ce qu'il ne voit pas.
      </p>

      <div class="rangee" aria-hidden="true">
        {rangee.map((e) => (
          <div class="rangee__tel">
            <Telephone {...e} alt="" largeur={214} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= Expérience ================= -->
  <section class="section experience">
    <div class="page experience__interieur">
      <div>
        <p class="eyebrow">À qui vous parlez</p>
        <h2>Quinze ans de terrain,<br />des deux côtés de la table</h2>
      </div>
      <div>
        <p class="prose">
          Développeur d'abord, puis chef de projets, puis Product Owner. En
          clientèle directe, chez des éditeurs, et dans des groupes où un
          déploiement se compte en milliers de postes. Du code écrit, des budgets
          tenus, des périmètres arbitrés, des choix défendus devant des auditeurs
          externes.
        </p>
        <p class="prose">
          Concrètement, quand vous décrivez un besoin, <strong>ce sont aussi les
          risques, les dépendances et ce qui va coincer dans six mois qui
          s'entendent</strong> — pas seulement la fonctionnalité.
        </p>
        <a class="bouton bouton--fantome experience__lien" href={lien('/experience')}>
          Voir le parcours en détail
        </a>
      </div>
    </div>
  </section>

  <!-- ================= Le périmètre pris en charge ================= -->
  <section class="section section--creux">
    <div class="page">
      <div class="titre-section">
        <div>
          <p class="eyebrow">Le périmètre</p>
          <h2>Du problème à l'application en ligne</h2>
        </div>
      </div>
      <div class="grille trio services">
        <article>
          <h3>Cadrage produit</h3>
          <p>Entretiens, analyse du domaine, étude de l'existant, arbitrage du périmètre. Le livrable est un document que vous pouvez lire, contester et garder.</p>
        </article>
        <article>
          <h3>Conception d'interface</h3>
          <p>Parcours et écrans dessinés au pixel, en clair et en sombre, sur téléphone comme sur écran large. Vous validez ce que vous verrez à la livraison.</p>
        </article>
        <article>
          <h3>Développement mobile</h3>
          <p>Applications iOS et Android, avec le soin qu'il faut pour qu'elles paraissent natives plutôt que portées.</p>
        </article>
        <article>
          <h3>Développement web</h3>
          <p>Sites et applications rapides, accessibles, qui tiennent la charge et se référencent. Ce site en est lui-même un exemple.</p>
        </article>
        <article>
          <h3>Back-end et données</h3>
          <p>Modèle de domaine explicite, API claires, migrations propres. La partie qu'on ne voit pas est celle qui décide de la suite.</p>
        </article>
        <article>
          <h3>Mise en ligne et suite</h3>
          <p>Déploiement, publication sur les stores, mesure et corrections. Un produit livré n'est pas un produit fini.</p>
        </article>
      </div>
    </div>
  </section>

  <AppelAction />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 42%; right: -14%; top: -14%; bottom: -22%;
    background: radial-gradient(closest-side, rgba(154, 107, 52, 0.13), transparent 72%);
    filter: blur(30px);
    pointer-events: none;
  }

  .hero__interieur {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero h1 { margin-bottom: 1.7rem; }
  .hero h1 em { font-style: italic; color: var(--bronze); }
  .hero .chapeau { margin-bottom: 2.3rem; }
  .hero__boutons { display: flex; align-items: center; gap: 1.7rem; flex-wrap: wrap; }

  /* Un éventail de trois téléphones. Tout est positionné depuis le centre :
     l'écartement est donc symétrique et reste dans la boîte de rognage, quelle
     que soit la largeur. Le bas est coupé net et les appareils se recouvrent —
     aucun écran n'est jamais donné en entier. */
  .hero__eventail {
    position: relative;
    height: clamp(19rem, 30vw, 26rem);
    margin-inline: clamp(-2rem, -2.5vw, -1rem);
    overflow: hidden;
  }
  /* Largeur explicite : un élément en absolu calé à « left: 50% » ne dispose
     que de la moitié droite pour s'étendre, et le cadre s'y rétracterait. */
  .hero__tel {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12.4rem;
    transform-origin: bottom center;
  }
  .hero__tel--avant { width: 14.5rem; }
  .hero__tel--gauche { z-index: 1; transform: translateX(calc(-50% - 6.4rem)) translateY(2.2rem) rotate(-8deg); }
  .hero__tel--droite { z-index: 2; transform: translateX(calc(-50% + 6.4rem)) translateY(2.2rem) rotate(8deg); }
  .hero__tel--avant  { z-index: 3; transform: translateX(-50%); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__tel { transition: transform 0.55s cubic-bezier(0.2, 0.7, 0.3, 1); }
    .hero__eventail:hover .hero__tel--gauche { transform: translateX(calc(-50% - 7.6rem)) translateY(1.4rem) rotate(-11deg); }
    .hero__eventail:hover .hero__tel--droite { transform: translateX(calc(-50% + 7.6rem)) translateY(1.4rem) rotate(11deg); }
    .hero__eventail:hover .hero__tel--avant  { transform: translateX(-50%) translateY(-0.5rem); }
  }

  /* ---------- bandeau ---------- */
  .bandeau { padding-block: clamp(2.75rem, 5.5vw, 4.25rem); }
  .bandeau__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .bandeau__phrase {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: clamp(1.45rem, 2.4vw, 1.95rem);
    line-height: 1.24;
    letter-spacing: -0.018em;
    margin: 0;
  }
  .bandeau__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
  }
  .bandeau__liste li { display: grid; gap: 0.55rem; }
  .bandeau__liste span:last-child {
    font-size: 0.85rem;
    color: var(--gris);
    line-height: 1.45;
    max-width: 22ch;
  }

  /* ---------- conviction ---------- */
  .conviction {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .conviction__texte { font-size: 1.06rem; }

  /* ---------- titres de section ---------- */
  .titre-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .introduction { margin-top: -1.5rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  /* ---------- étapes ---------- */
  .etapes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }
  .etape {
    padding: 2rem clamp(1rem, 2vw, 1.8rem) 1.8rem 0;
    border-top: 1px solid var(--trait);
    border-right: 1px solid var(--trait);
    position: relative;
  }
  .etape:nth-child(4n) { border-right: 0; }
  .etape::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    width: 38px; height: 2px;
    background: var(--bronze);
  }
  .etape h3 { margin: 0.9rem 0 0.7rem; }
  .etape p { color: var(--encre-douce); font-size: 0.95rem; }
  .etape__meta { margin: 1.5rem 0 0; display: grid; gap: 0.55rem; }
  .etape__meta div {
    display: flex; justify-content: space-between; gap: 1rem;
    border-top: 1px solid var(--trait-fin); padding-top: 0.55rem;
  }
  .etape__meta dt { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris-clair); }
  .etape__meta dd { margin: 0; font-size: 0.8rem; font-weight: 550; text-align: right; }

  /* ---------- rangée chevauchée ---------- */
  .rangee {
    position: relative;
    display: flex;
    justify-content: center;
    height: clamp(15rem, 24vw, 21rem);
    margin-inline: clamp(-2.5rem, -3vw, -1.5rem);
    padding-inline: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
  }
  /* L'élément flex porte la largeur : sans elle, le « width: 100% » du cadre
     de téléphone n'a rien à quoi se référer et l'appareil s'effondre.
     La marge négative vaut ~22 % de la largeur, ce qui laisse un peu plus de
     la moitié de chaque écran visible. */
  .rangee__tel { flex: none; width: 13.4rem; margin-inline: -3rem; }
  .rangee__tel:nth-child(1) { z-index: 1; transform: translateY(1.6rem) rotate(-3deg); }
  .rangee__tel:nth-child(2) { z-index: 2; transform: translateY(0.4rem) rotate(-1deg); }
  .rangee__tel:nth-child(3) { z-index: 3; transform: translateY(0.4rem) rotate(1deg); }
  .rangee__tel:nth-child(4) { z-index: 4; transform: translateY(1.6rem) rotate(3deg); }


  /* ---------- expérience ---------- */
  .experience__interieur {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .experience__interieur .prose + .prose { margin-top: 1.15rem; }
  .experience__lien { margin-top: 2rem; }

  /* ---------- services ---------- */
  .services article { border-top: 1px solid var(--trait); padding-top: 1.4rem; }
  .services h3 { margin-bottom: 0.6rem; }
  .services p { color: var(--encre-douce); font-size: 0.95rem; }

  /* ---------- adaptation ---------- */
  @media (max-width: 980px) {
    .hero__interieur { grid-template-columns: 1fr; }
    .conviction, .bandeau__grille, .experience__interieur { grid-template-columns: 1fr; }
    .etapes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .etape:nth-child(2n) { border-right: 0; }
    .rangee__tel { width: 11.5rem; margin-inline: -2.6rem; }
    .rangee__tel:nth-child(4) { display: none; }
  }
  @media (max-width: 620px) {
    .etapes { grid-template-columns: 1fr; }
    .etape { border-right: 0; padding-right: 0; }
    .bandeau__liste { grid-template-columns: 1fr; }
    .bandeau__liste li { display: flex; align-items: baseline; gap: 1rem; }
    .bandeau__liste span:last-child { max-width: none; }
    /* Sur téléphone, l'éventail se resserre et la rangée tombe à deux. */
    .hero__eventail { height: clamp(15rem, 58vw, 18rem); }
    .hero__tel { width: 9.5rem; }
    .hero__tel--avant { width: 11rem; }
    .hero__tel--gauche { transform: translateX(calc(-50% - 3.6rem)) translateY(1.8rem) rotate(-9deg); }
    .hero__tel--droite { transform: translateX(calc(-50% + 3.6rem)) translateY(1.8rem) rotate(9deg); }
    .rangee { height: clamp(12rem, 46vw, 15rem); }
    .rangee__tel { width: 10rem; margin-inline: -2.2rem; }
    .rangee__tel:nth-child(3) { display: none; }
  }
</style>
