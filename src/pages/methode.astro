---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import Iphone3D from '../components/Iphone3D.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { ecran } from '../lib/ecrans';

const temps = [
  {
    ancre: 'ecouter',
    titre: 'Écouter',
    resume: 'Comprendre votre métier avant de vous proposer quoi que ce soit.',
    texte: [
      "Un entretien, sans grille de questions toute faite et sans démonstration commerciale. Ce que je cherche à savoir : ce que vous faites, qui s'en sert, ce qui coince aujourd'hui, et ce que vous avez déjà tenté.",
      "J'en tire une note écrite de ce que j'ai compris, dans les mots de votre métier, pas dans les miens. Vous la corrigez. Tant qu'elle sonne faux à la lecture, rien ne commence : un malentendu à cette étape se paie au centuple plus tard.",
    ],
    livrables: ['Note de cadrage écrite', 'Reformulation de votre problème', 'Les questions qui restent ouvertes'],
    delai: 'Sous une semaine',
    engagement: 'La note est à vous, même si vous ne donnez pas suite.',
  },
  {
    ancre: 'cadrer',
    titre: 'Cadrer',
    resume: 'Réduire le problème à ce qui compte, et écrire pourquoi.',
    texte: [
      "C'est l'étape que la plupart des projets sautent, et c'est celle qui décide de tout. On regarde ce qui existe, on identifie les décisions structurantes, et on tranche : ce qui entre dans la première version, ce qui attend, ce qui n'existera jamais.",
      "Chaque arbitrage est écrit avec sa raison. Ça paraît bureaucratique jusqu'au jour où la question revient en réunion, six mois plus tard, et où la réponse est déjà là, avec son argument.",
    ],
    livrables: ['Périmètre de la première version', 'Décisions de conception argumentées', 'Ce qui est explicitement reporté'],
    delai: 'Une à deux semaines',
    engagement: "Si le cadrage montre qu'il ne faut pas construire l'application, je vous le dis.",
  },
  {
    ancre: 'valider',
    titre: 'Valider',
    resume: 'Des écrans réels, corrigés ensemble, avant la moindre ligne de code.',
    texte: [
      "Pas de boîtes grises, pas de schéma d'architecture en guise de maquette. Des écrans finis, à la bonne taille, avec vos vrais libellés et vos vraies données d'exemple. En clair et en sombre. Sur téléphone comme sur écran large.",
      'On les regarde ensemble, vous les annotez, je corrige. Reprendre un écran coûte une heure ; reprendre la même chose après développement coûte une semaine et entame la confiance.',
    ],
    livrables: ['Maquettes cliquables de chaque parcours', "Parcours d'erreur et cas limites", 'Le périmètre visuel figé'],
    delai: 'Quelques jours par parcours',
    engagement: 'Rien ne part en développement sans un écran que vous avez validé.',
  },
  {
    ancre: 'construire',
    titre: 'Construire',
    resume: 'Par tranches complètes, livrées une par une.',
    texte: [
      "Une tranche, c'est un parcours qui fonctionne de bout en bout : l'écran, la logique, les données, la mise en ligne. Je la termine, je vous la livre, vous l'utilisez pour de vrai. Puis la suivante.",
      'Ce que je ne fais jamais : ouvrir cinq chantiers en parallèle et vous montrer soixante pour cent de chacun. Un produit à soixante pour cent ne se montre pas, ne se teste pas, et ne se corrige pas.',
    ],
    livrables: ['Application en ligne à chaque tranche', 'Code documenté et testé', 'Publication sur les stores'],
    delai: 'Au rythme des tranches',
    engagement: 'Chaque livraison est utilisable, pas seulement démontrable.',
  },
];

const engagements = [
  { mot: 'Écoute', texte: "Un entretien de cadrage avant tout devis, et une note écrite de ce que j'ai compris, que vous pouvez corriger." },
  { mot: 'Compréhension', texte: "Votre problème vous est restitué dans les mots de votre métier. Si la note sonne faux à la lecture, c'est que je n'ai pas compris." },
  { mot: 'Rapidité', texte: 'Des maquettes cliquables en quelques jours. La vitesse vient du cadrage, jamais de la précipitation.' },
  { mot: 'Validation', texte: 'La maquette est le contrat. Vous ne découvrez rien à la livraison.' },
  { mot: 'Efficacité', texte: 'On construit le parcours qui porte la valeur et on reporte le reste, en le disant et en écrivant pourquoi.' },
  { mot: 'Modernité', texte: 'Des interfaces qui tiennent la comparaison avec ce que vos utilisateurs manipulent tous les jours. Les écrans sont en ligne : jugez-les.' },
];
---
<Base titre="Méthode" description="Écouter, cadrer, valider, construire. La méthode de Moamind Solutions, avec ses livrables, ses délais et ses engagements." langue="fr" page="methode">
  <Bande hauteur="680px" biais="56%" reserve="0px">
    <div class="ouv w">
      <div>
        <span class="etiq">La méthode</span>
        <h1>Comprendre d'abord<br /><span class="leger">construire ensuite.</span></h1>
        <p class="sous">La plupart des applications qui échouent ont été très bien développées. Elles répondaient simplement aux mauvaises questions. Voilà comment on s'assure que ce ne sera pas la vôtre.</p>
      </div>
      <nav class="escalier" aria-label="Les quatre temps">
        {temps.map((t, i) => (
          <a class="marche" href={`#${t.ancre}`} style={`--rang:${i}`}><b>{i + 1}</b><span><strong>{t.titre}</strong><span>{t.delai}</span></span></a>
        ))}
      </nav>
    </div>
  </Bande>

  <div class="w">
    {temps.map((t, i) => (
      <section class="temps" id={t.ancre}>
        <div class="visuel" aria-hidden="true">
          {i === 0 && (
            <div class="doc">
              <p class="doc-titre">Note de cadrage</p>
              <p class="meta">Version 2 · corrigée par le client</p>
              <p class="rub">Ce que vous faites</p><div class="l" style="width:94%"></div><div class="l" style="width:80%"></div>
              <p class="rub">Qui s'en sert</p><div class="l" style="width:88%"></div><div class="l" style="width:62%"></div>
              <p class="rub">Ce qui coince aujourd'hui</p><div class="l" style="width:90%"></div>
              <p class="corr">✎ <span>« Ce ne sont pas les clients qui se plaignent, ce sont les chauffeurs. »</span></p>
            </div>
          )}
          {i === 1 && (
            <>
              <div class="tableau">
                <div class="col" style="background:var(--voile)"><p class="col-titre">Version 1</p><span>Réserver un créneau</span><span>Payer d'avance</span><span>Suivre la charge</span><span>Noter l'hôte</span></div>
                <div class="col" style="background:#F2EEEA"><p class="col-titre">Plus tard</p><span>Abonnements</span><span>Parrainage</span></div>
                <div class="col" style="background:#F2EEEA"><p class="col-titre">Jamais</p><span>Facturer au kWh</span></div>
              </div>
              <p class="pourquoi"><b>Pourquoi « jamais » :</b> facturer au kWh exigerait un compteur certifié et ferait de l'hôte un revendeur d'électricité.</p>
            </>
          )}
          {i === 2 && (
            <div class="scene-valider">
              <Iphone3D ecran={ecran('teamago', 'Decompte')} largeur={230} haut="#F1F1EA" style="left:50%;top:44px;margin-left:-115px;transform:rotateY(-14deg) rotateX(6deg)" />
              <span class="bulle" style="left:34px;top:64px">Remonter le total en haut ?</span>
              <span class="bulle" style="right:22px;top:142px">Afficher le nombre de parts voyageur ?</span>
              <span class="bulle" style="left:22px;top:226px">Et si un péage s'ajoute en route ?</span>
              <span class="bulle" style="right:40px;top:306px;background:#fff;color:var(--encre)">Corrigé ✓</span>
              <span class="bulle" style="left:56px;top:388px;background:#1F8A5B">Écran validé</span>
            </div>
          )}
          {i === 3 && (
            <div class="frise">
              <div><span><b>Tranche 1 · Trouver une borne</b>Recherche, fiche, disponibilités</span><em style="background:#DDF3E6;color:#1F7A4D">En ligne</em><span class="jauge"><i style="width:100%"></i></span></div>
              <div><span><b>Tranche 2 · Réserver et payer</b>Créneau, prix fixé, paiement</span><em style="background:#FFE7D6;color:var(--f1)">En cours</em><span class="jauge"><i style="width:60%"></i></span></div>
              <div><span><b>Tranche 3 · Espace hôte</b>Disponibilités, revenus</span><em style="background:#EEEAF0;color:#6B6474">Prévue</em><span class="jauge"><i style="width:0"></i></span></div>
            </div>
          )}
        </div>
        <div class="corps">
          <p class="num"><b>{i + 1}</b><span class="pastille">{t.delai}</span></p>
          <h2>{t.titre}</h2>
          <p class="resume">{t.resume}</p>
          <div class="long">{t.texte.map((p) => <p>{p}</p>)}</div>
          <div class="recoit">
            <div class="liste"><p class="petit">Ce que vous recevez</p><ul>{t.livrables.map((l) => <li>{l}</li>)}</ul></div>
            <p class="engage"><span class="petit">L'engagement</span>{t.engagement}</p>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="sec w sombre">
    <div class="tete"><h2 class="t2">Six mots que tout le monde revendique, et ce qu'ils coûtent</h2></div>
    <dl class="grille-3 engagements">{engagements.map((e) => <div class="carte"><dt>{e.mot}</dt><dd>{e.texte}</dd></div>)}</dl>
  </section>

  <AppelFinal titre="Commençons par écouter" texte="Le premier entretien ne vous engage à rien. Vous repartez avec une note écrite de ce que j'ai compris de votre projet, et elle est à vous, même si vous vous arrêtez là." langue="fr" />
</Base>

<style>
  /* ---------- ouverture : les quatre temps en escalier, qui sortent du bandeau ---------- */
  .ouv { display: grid; grid-template-columns: minmax(0, 600px) minmax(0, 1fr); gap: 40px; padding-top: 56px; }
  /* Chaque ligne du titre tient sur une ligne : la taille suit la colonne (coefficient calé sur la plus longue ligne du texte actuel). */
  .ouv > div:first-child { container-type: inline-size; }
  .ouv h1 { font-size: min(clamp(2.75rem, 6vw, 4.5rem), 10cqi); }
  .escalier { position: relative; min-height: 560px; }
  .marche { position: absolute; left: calc(var(--rang) * 70px); top: calc(10px + var(--rang) * 130px); width: 330px; background: #fff; color: var(--encre); border-radius: 22px; padding: 18px 48px 18px 20px; display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: center; box-shadow: 0 30px 60px -28px rgba(30,10,4,.5); transition: transform .2s ease, box-shadow .2s ease; }
  .marche:hover { transform: translateX(6px); box-shadow: 0 34px 64px -26px rgba(30,10,4,.6); }
  .marche::after { content: '→'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: var(--f2); font-weight: 700; }
  .marche b { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--voile); color: var(--f1); font-size: 17px; }
  .marche strong { display: block; font-size: 18px; letter-spacing: -.02em; }
  .marche strong + span { font: 500 13px var(--ui); color: var(--gris); }

  /* ---------- les quatre temps, en rangées alternées ---------- */
  .temps { display: grid; grid-template-columns: 1fr 1fr; gap: 90px; align-items: center; padding-block: 90px; }
  .temps + .temps { border-top: 1px solid var(--trait); }
  .temps:nth-child(even) .visuel { order: 2; }
  .visuel { position: relative; height: 480px; border-radius: 32px; background: var(--creme); overflow: hidden; }
  .num { display: inline-flex; gap: 10px; align-items: center; margin-bottom: 18px; }
  .num b { width: 40px; height: 40px; border-radius: 50%; background: var(--encre); color: #fff; display: grid; place-items: center; font-size: 16px; }
  .temps h2 { font-size: clamp(2.5rem, 4.5vw, 3.25rem); letter-spacing: -.045em; font-weight: 800; line-height: 1; margin-bottom: 14px; }
  .resume { font-size: clamp(1.25rem, 2vw, 1.375rem); line-height: 1.4; font-weight: 700; letter-spacing: -.015em; margin-bottom: 22px; }
  .long p { font-size: 16.5px; line-height: 1.7; color: var(--encre-2); margin-bottom: 14px; }
  .recoit { margin-top: 26px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .liste { padding: 18px 20px; border-radius: 20px; background: var(--creme); }
  .liste ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; font-size: 14.5px; font-weight: 600; }
  .liste li { display: grid; grid-template-columns: 20px 1fr; }
  .liste li::before { content: '✓'; color: var(--f2); }
  .petit { display: block; font-size: 12px; font-weight: 700; color: var(--gris); margin-bottom: 8px; }
  .engage { padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg, var(--f1), var(--f2)); color: #fff; font-size: 16px; line-height: 1.45; font-weight: 700; }
  .engage .petit { color: rgba(255,255,255,.75); }

  /* ---------- livrables dessinés ---------- */
  .doc { position: absolute; left: 60px; right: 60px; top: 50px; background: #fff; border-radius: 18px; padding: 26px; box-shadow: 0 30px 60px -30px rgba(21,18,31,.25); font-family: var(--ui); }
  .doc-titre { font: 700 18px var(--titre); margin-bottom: 4px; }
  .meta { font-size: 12px; color: var(--gris); margin-bottom: 18px; }
  .rub { font-size: 11.5px; font-weight: 600; color: var(--f2); margin: 14px 0 7px; }
  .l { height: 7px; border-radius: 4px; background: #F0EAE5; margin-bottom: 7px; }
  .corr { display: flex; gap: 10px; align-items: start; margin-top: 12px; background: #FFE7D6; color: var(--f1); border-radius: 10px; padding: 10px 12px; font-size: 13px; font-weight: 500; }
  .tableau { position: absolute; inset: 44px 40px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; font-family: var(--ui); }
  .col { border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 8px; align-self: start; }
  .col-titre { font: 700 14px var(--titre); margin-bottom: 4px; }
  .col span { background: #fff; border-radius: 10px; padding: 9px 11px; font-size: 12.5px; box-shadow: 0 1px 2px rgba(0,0,0,.06); }
  .pourquoi { position: absolute; left: 40px; right: 40px; bottom: 36px; background: var(--encre); color: #fff; border-radius: 16px; padding: 14px 16px; font: 500 13px/1.45 var(--ui); }
  .pourquoi b { color: var(--f3); }
  .scene-valider { position: absolute; inset: 0; perspective: 1600px; }
  .bulle { position: absolute; z-index: 5; font: 600 13px var(--ui); padding: 10px 13px; border-radius: 14px; background: var(--encre); color: #fff; box-shadow: 0 14px 28px -12px rgba(0,0,0,.45); white-space: nowrap; }
  .frise { position: absolute; inset: 60px 50px; display: grid; gap: 12px; align-content: start; font-family: var(--ui); }
  .frise div { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; background: #fff; border-radius: 16px; padding: 16px 18px; font-size: 14px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
  .frise b { font-family: var(--titre); font-size: 15px; display: block; }
  .frise em { font-style: normal; font-weight: 600; font-size: 12px; padding: 5px 10px; border-radius: 99px; }
  .jauge { height: 6px; border-radius: 3px; background: #F0EAE5; grid-column: 1 / -1; overflow: hidden; }
  .jauge i { display: block; height: 100%; background: linear-gradient(90deg, var(--f2), var(--f3)); }

  /* ---------- engagements ---------- */
  .engagements { margin: 0; }
  .engagements dt { font-size: 22px; font-weight: 800; letter-spacing: -.025em; margin-bottom: 10px; }
  .engagements dd { margin: 0; color: #B9B2BF; font-size: 15.5px; line-height: 1.6; }

  /* ---------- adaptation ---------- */
  @media (max-width: 1100px) {
    .ouv { grid-template-columns: 1fr; gap: 8px; }
    .escalier { min-height: 0; display: grid; gap: 10px; padding-bottom: 48px; max-width: 520px; }
    .marche { position: relative; left: auto; top: auto; width: auto; }
    .temps { grid-template-columns: 1fr; gap: 40px; padding-block: 64px; }
    .temps:nth-child(even) .visuel { order: 0; }
  }
  @media (max-width: 700px) {
    .visuel { zoom: .74; }
    .recoit { grid-template-columns: 1fr; }
  }
</style>
