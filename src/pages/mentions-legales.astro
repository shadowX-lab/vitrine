---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import { STUDIO } from '../config';

const sommaire = [
  ['editeur', 'Éditeur du site'],
  ['contact', 'Me contacter'],
  ['hebergement', 'Hébergement'],
  ['propriete', 'Propriété intellectuelle'],
  ['donnees', 'Données personnelles'],
  ['cookies', 'Cookies'],
];
---
<Base titre="Mentions légales" description="Mentions légales et politique de confidentialité du site de Moamind Solutions.">
  <Bande hauteur="430px" biais="70%" reserve="0px">
    <div class="ouv w"><span class="etiq">Informations légales</span><h1>Mentions légales</h1></div>
  </Bande>

  <div class="legal w">
    <nav aria-label="Sommaire">
      <ol class="sommaire">{sommaire.map(([ancre, titre]) => <li><a href={`#${ancre}`}>{titre}</a></li>)}</ol>
    </nav>
    <div class="texte long">
      <p class="rappel">Ce site vient d'être mis en ligne : les informations ci-dessous sont à compléter avec les données réelles de la structure avant toute diffusion publique.</p>

      <section class="bloc" id="editeur">
        <h2>Éditeur du site</h2>
        <p>
          <span translate="no">{STUDIO.nom}</span> · raison sociale&nbsp;<em>à&nbsp;compléter</em><br />
          Forme juridique et capital social&nbsp;:&nbsp;<em>à&nbsp;compléter</em><br />
          Siège social&nbsp;:&nbsp;<em>à&nbsp;compléter</em><br />
          SIREN / SIRET&nbsp;:&nbsp;<em>à&nbsp;compléter</em><br />
          Numéro de TVA intracommunautaire&nbsp;:&nbsp;<em>à&nbsp;compléter</em><br />
          Directeur de la publication&nbsp;:&nbsp;<em>à&nbsp;compléter</em>
        </p>
      </section>

      <section class="bloc" id="contact">
        <h2>Me contacter</h2>
        <p>Toute demande passe par le formulaire de la page Contact. Aucune adresse électronique n'est publiée sur ce site.</p>
      </section>

      <section class="bloc" id="hebergement">
        <h2>Hébergement</h2>
        <p>Le site est hébergé par GitHub Pages, GitHub, Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis.</p>
      </section>

      <section class="bloc" id="propriete">
        <h2>Propriété intellectuelle</h2>
        <p>L'ensemble des contenus de ce site, textes, maquettes, captures d'écran des applications présentées, identité visuelle et code, est la propriété de <span translate="no">{STUDIO.nom}</span>, sauf mention contraire. Toute reproduction ou représentation, totale ou partielle, sans autorisation écrite préalable est interdite.</p>
      </section>

      <section class="bloc" id="donnees">
        <h2>Données personnelles</h2>
        <p>Les informations transmises par le formulaire de contact (nom, organisation, adresse électronique, nature du projet, échéance, budget et message) servent exclusivement à répondre à votre demande. Elles ne sont ni revendues, ni cédées, ni utilisées à des fins de prospection par des tiers.</p>
        <p>L'acheminement des messages est assuré par Web3Forms. Les données sont conservées le temps nécessaire au traitement de la demande, et au maximum trois ans après le dernier échange.</p>
        <p>Conformément au règlement général sur la protection des données, vous disposez d'un droit d'accès, de rectification, d'effacement, de limitation, d'opposition et de portabilité de vos données. Ces droits s'exercent par le formulaire de contact. Vous pouvez également introduire une réclamation auprès de la CNIL.</p>
      </section>

      <section class="bloc" id="cookies">
        <h2>Cookies et mesure d'audience</h2>
        <p>Ce site ne dépose aucun cookie et n'utilise aucun outil de mesure d'audience ni de traçage publicitaire. Aucune bannière de consentement n'est donc nécessaire.</p>
      </section>
    </div>
  </div>
</Base>

<script>
  // Surligne dans le sommaire la section en cours de lecture ; en bas de page, la dernière.
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.sommaire a')];
  const blocs = [...document.querySelectorAll<HTMLElement>('.bloc[id]')];
  const marquer = (id: string) => liens.forEach((l) => l.classList.toggle('actif', l.hash === `#${id}`));
  const suivre = () => {
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) return marquer(blocs.at(-1)!.id);
    const courant = blocs.filter((b) => b.getBoundingClientRect().top <= innerHeight * 0.3).at(-1) ?? blocs[0]!;
    marquer(courant.id);
  };
  addEventListener('scroll', suivre, { passive: true });
  liens.forEach((l) => l.addEventListener('click', () => setTimeout(() => marquer(l.hash.slice(1)), 700)));
  suivre();
</script>

<style>
  .ouv { padding-top: 56px; padding-bottom: 130px; }
  .legal { display: grid; grid-template-columns: 260px minmax(0, 720px); gap: 80px; padding-block: 70px 120px; }
  nav { position: sticky; top: 30px; align-self: start; }
  .sommaire { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 14.5px; font-weight: 600; }
  .sommaire a { display: block; padding: 10px 14px; border-radius: 12px; color: var(--encre-2); transition: background .15s, color .15s; }
  .sommaire a:hover { background: var(--creme); color: var(--encre); }
  .sommaire a.actif { background: var(--voile); color: var(--f1); }
  .rappel { background: var(--voile); border-radius: 20px; padding: 18px 22px; font-size: 15px; line-height: 1.55; color: var(--f1); font-weight: 600; margin-bottom: 40px; }
  .bloc { padding: 30px 0; border-top: 1px solid var(--trait); }
  .bloc h2 { font-size: 26px; letter-spacing: -.03em; font-weight: 800; margin-bottom: 14px; }
  .bloc p { font-size: 16.5px; line-height: 1.75; color: var(--encre-2); margin-bottom: 12px; }
  .bloc em { font-style: normal; background: #F4EFEA; padding: 1px 7px; border-radius: 6px; color: var(--gris); }

  @media (max-width: 1100px) {
    .legal { grid-template-columns: 1fr; gap: 0; padding-top: 40px; }
    nav { display: none; }
  }
</style>
